DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="change-this-to-a-random-long-string"

# Sólo para tu máquina. Ponla en 1 si tu red bloquea el puerto 5432: la app
# usará el endpoint HTTP de Neon (puerto 443) en lugar de TCP.
# NO la definas en Vercel: allí el 5432 funciona.
# LABUILD_HTTP_DB=1